{
  "name": "@basalt-js/ci",
  "version": "0.0.0",
  "description": "Shared tooling for basalt-js repositories: Biome, ESLint and TypeScript configs, the release script, the bundle-size gate, and reusable GitHub workflows.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basalt-js/ci.git"
  },
  "homepage": "https://github.com/basalt-js/ci#readme",
  "bugs": {
    "url": "https://github.com/basalt-js/ci/issues"
  },
  "bin": {
    "basalt-release": "./bin/release.ts",
    "basalt-size": "./bin/size.ts"
  },
  "exports": {
    "./biome": "./biome.json",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./eslint": "./eslint/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "eslint",
    "biome.json",
    "tsconfig.base.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && eslint .",
    "lint:fix": "biome check --write . && eslint --fix .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "eslint-config-biome": "2.1.3",
    "eslint-plugin-jsdoc": "62.6.0",
    "eslint-plugin-sonarjs": "4.0.0",
    "eslint-plugin-unicorn": "63.0.0",
    "typescript-eslint": "8.58.0"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.4.0",
    "eslint": "^9.0.0",
    "typescript": ">=5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/bun": "1.4.4",
    "eslint": "^9",
    "lefthook": "2.1.1",
    "typescript": "6.0.3",
    "vitest": "4.0.18"
  },
  "trustedDependencies": [
    "lefthook"
  ]
}
